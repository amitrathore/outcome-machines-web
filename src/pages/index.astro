---
import "../styles/global.css";
import { machines } from "../data/machines";

const loop = [
  { n: "01", t: "Monitor", d: "Watches the goal continuously using the relevant business data and context." },
  { n: "02", t: "Explain", d: "Investigates likely drivers and shows the evidence behind them." },
  { n: "03", t: "Recommend", d: "Proposes an action with its evidence, expected effect, and policy constraints." },
  { n: "04", t: "Approve", d: "Pauses for the accountable owner to approve or reject the proposal." },
  { n: "05", t: "Execute", d: "Runs the approved action through an inspectable workflow." },
  { n: "06", t: "Learn", d: "Compares the observed result with the baseline and improves the next decision." },
];

---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />
    <script>const t=localStorage.getItem('theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');</script>
    <title>Outcome Machines — Build AI systems that improve your most important goals</title>
    <meta name="description" content="Outcome Machines connect business signals to governed decisions and measured results. See how a machine investigates, recommends, waits for approval, executes, and learns." />
    <meta property="og:title" content="Outcome Machines" />
    <meta property="og:description" content="Outcome Machines connect business signals to governed decisions and measured results." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://outcomemachines.com" />
    <meta property="og:image" content="https://outcomemachines.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Outcome Machines" />
    <meta name="twitter:description" content="Outcome Machines connect business signals to governed decisions and measured results." />
    <meta name="twitter:image" content="https://outcomemachines.com/og-image.png" />
    <script src="https://asset-tidycal.b-cdn.net/js/embed.js" async></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- NAV -->
    <nav class="nav" id="nav">
      <a class="brand" href="#top"><span class="mark"></span>Outcome Machines</a>
      <div class="nav-links">
        <a href="#machines">The Machines</a>
        <a href="#how">How it Works</a>
        <a href="#technology">The Technology</a>
        <a href="#movement">Outcomeering</a>
        <a href="/insights">Insights</a>
        <a href="#contact" class="btn btn--primary nav-cta">Book a demo<span class="arrow">→</span></a>
      </div>
    </nav>

    <!-- HERO -->
    <header class="hero" id="top">
      <div class="hero-grid-bg"></div>
      <div class="hero-glow"></div>
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <span class="eyebrow reveal">A new category of business system</span>
          <h1 class="display reveal" data-d="1">
            Build <span class="em">Outcome&nbsp;Machines</span> for your most important business goals.
          </h1>
          <p class="lede reveal" data-d="2">
            An Outcome Machine works continuously toward one measurable business goal.
            It investigates signals, recommends actions with evidence, waits for the right
            person to approve them, runs approved workflows, and measures what changed.
          </p>
          <div class="hero-actions reveal" data-d="3">
            <a href="#contact" class="btn btn--primary">Plan your first machine<span class="arrow">→</span></a>
            <a href="#how" class="btn btn--ghost">See how it works</a>
          </div>
          <div class="hero-path reveal" data-d="4" aria-label="From business signal to measured result">
            <span>Business signal</span><span aria-hidden="true">→</span><span>Recommendation</span><span aria-hidden="true">→</span><span>Human approval</span><span aria-hidden="true">→</span><span>Measured result</span>
          </div>
        </div>

        <!-- SIGNATURE: core loop engine -->
        <div class="hero-engine-wrap reveal" data-d="2">
          <div class="engine" aria-hidden="true">
            <div class="engine-ring"></div>
            <div class="engine-ring engine-ring--2"></div>
            <div class="engine-ring engine-ring--3"></div>
            <div class="engine-sweep"></div>
            <div class="engine-core">
              <div>
                <div class="lbl">Outcome</div>
                <div class="val">+ ↑</div>
              </div>
            </div>
            <div class="engine-node" style="--a:0deg;   --delay:0s">
              <div class="dot"></div><div class="nlbl"><span class="nnum">01</span> Monitor</div>
            </div>
            <div class="engine-node" style="--a:60deg;  --delay:1s">
              <div class="dot"></div><div class="nlbl"><span class="nnum">02</span> Explain</div>
            </div>
            <div class="engine-node" style="--a:120deg; --delay:2s">
              <div class="dot"></div><div class="nlbl"><span class="nnum">03</span> Recommend</div>
            </div>
            <div class="engine-node" style="--a:180deg; --delay:3s">
              <div class="dot"></div><div class="nlbl"><span class="nnum">04</span> Approve</div>
            </div>
            <div class="engine-node" style="--a:240deg; --delay:4s">
              <div class="dot"></div><div class="nlbl"><span class="nnum">05</span> Execute</div>
            </div>
            <div class="engine-node" style="--a:300deg; --delay:5s">
              <div class="dot"></div><div class="nlbl"><span class="nnum">06</span> Learn</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- DON'T BUY / BUY -->
    <section class="section section--tight">
      <div class="wrap">
        <div class="shead reveal">
          <span class="eyebrow">The core insight</span>
          <h2 class="h2">You don't buy technology.<br />You buy outcomes.</h2>
        </div>
        <div class="split reveal" data-d="1">
          <div class="col-no">
            <h3 class="h3">What is offered</h3>
            <ul class="buy-list">
              <li><span class="ic">×</span> AI &amp; Agents</li>
              <li><span class="ic">×</span> Decision Intelligence</li>
              <li><span class="ic">×</span> Knowledge Graphs</li>
              <li><span class="ic">×</span> Metric Governance</li>
              <li><span class="ic">×</span> BI Dashboards &amp; Reports</li>
            </ul>
          </div>
          <div class="col-yes">
            <h3 class="h3">What is needed</h3>
            <ul class="buy-list">
              <li><span class="ic">↑</span> Revenue growth</li>
              <li><span class="ic">↑</span> Cash recovery</li>
              <li><span class="ic">↑</span> Customer retention</li>
              <li><span class="ic">↑</span> Productivity &amp; performance</li>
              <li><span class="ic">↑</span> Reduced risk</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS / CORE LOOP -->
    <section class="section" id="how">
      <div class="wrap">
        <div class="shead reveal">
          <span class="eyebrow">The core loop</span>
          <h2 class="h2">From signal to accountable action.</h2>
          <p class="lede">The machine works with the relevant business data and context. A person approves consequential actions, and each completed action is measured against the goal.</p>
        </div>
        <div class="loop-steps reveal" data-d="1">
          {loop.map((s) => (
            <div class="loop-step">
              <span class="sn">{s.n}</span>
              <h4>{s.t}</h4>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- A WORKED EXAMPLE -->
    <section class="section section--tight example-section" id="example">
      <div class="wrap">
        <div class="shead reveal">
          <span class="eyebrow">Illustrative machine cycle</span>
          <h2 class="h2">A stockout becomes a decision.</h2>
          <p class="lede">A sample Revenue Recovery cycle shows the information an operator gets before action, and the result the machine would measure afterward. The scenario is illustrative, not a customer result.</p>
        </div>
        <div class="demo-video-wrap reveal" data-d="1">
          <video controls playsinline preload="none" poster="/outcome-machines-demo-poster.png" aria-label="Outcome Machines illustrative revenue recovery walkthrough">
            <source src="/outcome-machines-demo-full.mp4" type="video/mp4" />
            Your browser does not support this video.
          </video>
          <p>94.5-second illustrative walkthrough · Demo data</p>
        </div>
        <ol class="example-cycle reveal" data-d="1">
          <li><span class="example-label">01 · Signal</span><h3>Cover is running low</h3><p>A fast-moving SKU falls below its inventory-cover threshold in a high-demand region.</p></li>
          <li><span class="example-label">02 · Investigation</span><h3>Find the constraint</h3><p>The machine checks store-level demand, available inventory, replenishment timing, and supplier fill rate.</p></li>
          <li><span class="example-label">03 · Recommendation</span><h3>Move stock where needed</h3><p>It proposes a transfer from lower-velocity stores, with the expected effect and supporting evidence.</p></li>
          <li><span class="example-label">04 · Approval</span><h3>Keep an owner in control</h3><p>A merchandising or supply-chain owner reviews the proposal before the transfer workflow starts.</p></li>
          <li><span class="example-label">05 · Outcome</span><h3>Check what changed</h3><p>Recovered sales and stockout rate are compared with a baseline over the agreed measurement window.</p></li>
        </ol>
        <article class="decision-record reveal" data-d="2" aria-labelledby="decision-record-title">
          <div class="decision-record-heading">
            <div><span class="example-label">Illustrative decision record</span><h3 id="decision-record-title">Transfer stock to the constrained region</h3></div>
            <span class="decision-status">Awaiting approval</span>
          </div>
          <dl class="decision-record-grid">
            <div><dt>Signal</dt><dd>Inventory cover is below the agreed threshold for a fast-moving SKU.</dd></div>
            <div><dt>Evidence to review</dt><dd>Store demand, available stock, replenishment timing, and supplier fill rate.</dd></div>
            <div><dt>Proposed action</dt><dd>Transfer units from a lower-velocity store to the high-demand region.</dd></div>
            <div><dt>Policy check</dt><dd>Keep the sending store above its minimum cover; confirm the transfer is permitted.</dd></div>
            <div><dt>Decision owner</dt><dd>A merchandising or supply-chain owner can approve, reject, or request a revision.</dd></div>
            <div><dt>Measurement plan</dt><dd>Compare stockout rate and recovered sales with a baseline after the transfer. The record stays open until an observed result is available.</dd></div>
          </dl>
        </article>
      </div>
    </section>

    <!-- MACHINES -->
    <section class="section" id="machines">
      <div class="wrap">
        <div class="shead reveal">
          <span class="eyebrow">The catalog</span>
          <h2 class="h2">One machine per outcome.</h2>
          <p class="lede">Each machine focuses on one goal and the decisions that move it. These are example operating models; the signals, policies, and measures are configured for your organization.</p>
        </div>
        <div class="machines">
          {machines.map((m, i) => (
            <article class="machine reveal" data-d={(i % 3) + 1}>
              <div class="mhead">
                <span class="midx">OM-{String(i + 1).padStart(2, "0")}</span>
                <span class="status">{m.detail ? "Explore model" : "Example model"}</span>
              </div>
              <h3>{m.name}</h3>
              <p>{m.description}</p>
              <div class="machine-details">
                <div><span>Goal</span><strong>{m.goal}</strong></div>
                <div><span>Signal</span><strong>{m.signal}</strong></div>
                <div><span>Decision</span><strong>{m.decision}</strong></div>
                <div><span>Measure</span><strong>{m.kpi}</strong></div>
              </div>
              {m.detail && <a class="machine-link" href={`/machines/${m.slug}`}>See how it works <span aria-hidden="true">→</span></a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTROL AND MEASUREMENT -->
    <section class="section section--tight" id="control">
      <div class="wrap">
        <div class="shead reveal">
          <span class="eyebrow">Control and measurement</span>
          <h2 class="h2">Every action has a reason, an owner, and a result.</h2>
          <p class="lede">An Outcome Machine should make the path from evidence to action inspectable. Teams set the policy and approve consequential decisions; the machine records what happened next.</p>
        </div>
        <div class="control-grid reveal" data-d="1">
          <article><span class="example-label">01 · Evidence</span><h3>Show the reasoning</h3><p>Each recommendation identifies the signal, supporting data, and assumptions behind its expected effect.</p></article>
          <article><span class="example-label">02 · Approval</span><h3>Name the decision owner</h3><p>Policy names the human approver, sets the action boundaries, and determines which workflow can run after approval.</p></article>
          <article><span class="example-label">03 · Outcome</span><h3>Measure against a baseline</h3><p>The team sees the action taken, the observed result, and where the model needs correction.</p></article>
        </div>
      </div>
    </section>

    <!-- TECHNOLOGY -->
    <section class="section section--tight" id="technology">
      <div class="wrap">
        <div class="shead reveal">
          <span class="eyebrow">Under the hood</span>
          <h2 class="h2">The goal shapes the technology.</h2>
          <p class="lede">Each Outcome Machine brings together the data, reasoning, workflows, and measurement its goal requires. The mix depends on your organization and the systems you already use.</p>
        </div>
        <div class="technology-examples reveal" data-d="1">
          <span>Partner technologies</span>
          <a href="https://datacentriq.co/">DatacentrIQ <span aria-hidden="true">↗</span></a>
          <a href="https://opentangle.ai/">Opentangle.ai <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <!-- OUTCOMEERING -->
    <section class="section section--tight" id="movement">
      <div class="wrap">
        <div class="shead reveal">
          <span class="eyebrow">The book and the discipline</span>
          <h2 class="h2">Outcomeering is how organizations learn to improve.</h2>
          <p class="lede">Outcomeering is the discipline of understanding performance, making accountable decisions, acting on them, and learning from the results. It is the thinking behind Outcome Machines and the subject of a book.</p>
        </div>
        <div class="outcomeering-feature reveal" data-d="1">
          <div class="think-card">
            <div class="glow2"></div>
            <span class="booktag">The book · The discipline</span>
            <div class="booktitle">Outcomeering</div>
            <div class="booksub">How intelligent enterprises learn, decide and improve.</div>
            <a class="feature-link" href="https://outcomeering.com/">Explore Outcomeering <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- INSIGHTS -->
    <section class="section section--tight home-insights" id="insights">
      <div class="wrap home-insights-inner">
        <div>
          <span class="eyebrow">Insights / Outcome Intelligence</span>
          <h2 class="h2">Ideas for systems that learn from results.</h2>
          <p class="lede">Amit Rathore writes about the decisions, controls, and measurements that turn AI into accountable business improvement.</p>
          <a class="insights-text-link" href="/insights">Explore Insights <span aria-hidden="true">↗</span></a>
        </div>
        <a class="home-insights-feature" href="/insights/what-is-outcome-intelligence">
          <span class="tag">Founding essay · 4 min read</span>
          <h3>What Is Outcome Intelligence?</h3>
          <span>Read the essay <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta" id="contact">
      <div class="cta-glow"></div>
      <div class="wrap">
        <span class="eyebrow reveal" style="justify-content:center;">Start with one outcome</span>
        <h2 class="display reveal" data-d="1" style="margin-top:22px;">Pick a goal.<br />Plan a machine.</h2>
        <p class="lede reveal" data-d="2">Bring one business outcome. In the working session, we'll map the metric, the decisions that affect it, the data those decisions need, and a practical first deployment path.</p>
        <div class="tidycal-wrap reveal" data-d="3">
          <div class="tidycal-embed" data-path="amitrathore/30-min-to-an-outcome-machine"></div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="wrap footer-inner">
        <a class="brand" href="#top"><span class="mark"></span>Outcome Machines</a>
        <div class="fcols">
          <a href="#machines">The Machines</a>
          <a href="#how">Core Loop</a>
          <a href="#technology">The Technology</a>
          <a href="#movement">Outcomeering</a>
          <a href="/insights">Insights</a>
          <a href="/about">About</a>
          <a href="#contact">Book a demo</a>
        </div>
        <div class="fnote">© {new Date().getFullYear()} Outcome Machines</div>
        <button class="theme-toggle" id="theme-toggle" aria-label="Switch colour theme">◑ Light</button>
      </div>
    </footer>

    <script>
      // scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // nav border on scroll
      const nav = document.getElementById("nav");
      const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 24);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // theme toggle
      const toggle = document.getElementById("theme-toggle");
      const updateToggle = () => {
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        toggle.textContent = isLight ? "◑ Dark" : "◑ Light";
      };
      updateToggle();
      toggle.addEventListener("click", () => {
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        if (isLight) {
          document.documentElement.setAttribute("data-theme", "dark");
          localStorage.setItem("theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
          localStorage.removeItem("theme");
        }
        updateToggle();
      });
    </script>
  </body>
</html>
